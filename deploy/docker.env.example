# Copy to inkmesh.env next to compose.yaml. Secrets go here, never in git.
# PORT, HOST, INKMESH_DATA and NODE_ENV are set by the image.
BODY_SIZE_LIMIT=20M

# Origin from the reverse proxy's headers: adapter-node 6 reads no ORIGIN variable and, without these, assumes https, so plain-http form posts fail the CSRF check.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host
# Client address for the login throttle: the last X-Forwarded-For entry, the one your proxy appends.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# Email is off unless all three are set; a partial setup stops the start.
# SMTP server: smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465 (implicit TLS).
#SMTP_URL=smtps://user:pass@smtp.example:465
# From header of every email.
#MAIL_FROM=inkmesh <noreply@inkmesh.example>
# Public origin used in email links, never taken from the request.
#INKMESH_URL=https://inkmesh.example
# UTC hour of the daily digest, 0-23 (default 8).
#DIGEST_HOUR=8
