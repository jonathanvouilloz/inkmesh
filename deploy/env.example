# Copy to ~/.config/inkmesh/env. Secrets go here, never in git.
PORT=9310
HOST=127.0.0.1
BODY_SIZE_LIMIT=20M
INKMESH_DATA=/home/hermes/inkmesh-data
NODE_ENV=production

# Origin from the proxy headers (both phases): cloudflared sets X-Forwarded-Proto and Host.
# adapter-node 6 no longer reads an ORIGIN variable; without these two the adapter assumes https
# and a plain-http request (curl on localhost) fails the CSRF check with 403.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host
# Client address for the login throttle: Cloudflare's header. Safe because the port is bound to
# localhost and only the tunnel reaches it, so no client can forge it. XFF_DEPTH stays unset.
ADDRESS_HEADER=cf-connecting-ip
