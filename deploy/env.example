# Copy to ~/.config/inkmesh/env. Secrets go here, never in git.
PORT=9310
HOST=127.0.0.1
BODY_SIZE_LIMIT=20M
INKMESH_DATA=/home/hermes/inkmesh-data
NODE_ENV=production

# Phase A (quick tunnel): origin from the proxy headers, the hostname changes at each tunnel restart.
PROTOCOL_HEADER=x-forwarded-proto
HOST_HEADER=host

# Phase B (inkmesh.ch): remove the two lines above and use a fixed origin.
#ORIGIN=https://inkmesh.ch
