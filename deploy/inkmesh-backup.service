[Unit]
Description=inkmesh backup: workspaces to GitHub, daily database snapshot
OnFailure=inkmesh-alert@%N.service

[Service]
Type=oneshot
WorkingDirectory=%h/inkmesh-app
EnvironmentFile=%h/.config/inkmesh/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bash scripts/backup.sh
